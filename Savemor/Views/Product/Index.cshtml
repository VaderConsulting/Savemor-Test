@model Savemor.Models.ProductsPageViewModel
@{
    ViewBag.Title = "Products";
   
    var CategoryList = Model.Category.ToList();
    var ProductList = Model.Product.ToList();
}

<table class="products">
    <tr>
        <td class="productspagingbar" colspan="4">Showing 1-20 of @ProductList.Count products</td>
        <td class="productsdropdownbox">Drop Down Box</td>
    </tr>
    @{
        for (int i = 0; i <= ProductList.Count - 1; i += 4)
        { 
            <tr class="greentopborder">
                @{
                    for (int j = i; j < i + 4; j++)
                    {
                        if (j< ProductList.Count)
                        {
                            <td class="productimage">
                                <a href="@Url.Action("Product", "Product", new RouteValueDictionary(new { ProductID = ProductList[j].ID }))">
                                    <img class="productmedium" src="../images/product/@Html.DisplayFor(modelItem => ProductList[j].Image)" alt="@Html.DisplayFor(modelItem => ProductList[j].Name) image" />
                                </a>
                            </td>
                        }
                    }
                }
            </tr>
            <tr>
                @{
                    for (int j = i; j < i + 4; j++)
                    {
                        if (j< ProductList.Count)
                        {
                            <td class="productinfo">
                                <span class="productname">@Html.DisplayFor(modelItem => ProductList[j].Name)</span><br />
                                @{
                                    decimal Price = ProductList[j].Price;
                                    decimal RecommendedPrice = ProductList[j].RecommendedPrice;
                                    decimal Saving = RecommendedPrice - Price;
                                    string SaveText = "Save up to $" + Saving;
                            
                                    if (Saving <= 0m) 
                                    {
                                        SaveText = "";
                                    }
                            
                                    <span class="productprice">Our price: $@Html.DisplayFor(modelItem => ProductList[j].Price)</span><br />
                                    <span class="saveamount">@SaveText</span><br />
                                    <span class="productbuttons">
								        <a href="#"><img class="productbutton" src="../images/RP_menu.png" /></a>
								        <a href="#"><img class="productbutton" src="../images/SP_menu.png" /></a>
								        <a href="#"><img class="productbutton" src="../images/MI_menu.png" /></a>
								        <a href="#"><img class="productbutton" src="../images/ATC_menu.png" /></a>
							        </span>
                                }        
                            </td>
                        }
                    }
                }
            </tr>
        }
    }
</table>

